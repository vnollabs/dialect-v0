{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dialect.vnol.net/api/v1/schema/bundle.schema.json",
  "title": "VN Dialect API v1: lexicon.json and regions/<id>.json",
  "description": "A set of full entries. A region bundle keeps only the senses in that region or its sub-regions.",
  "type": "object",
  "allOf": [{ "$ref": "meta.schema.json#/$defs/header" }],
  "required": ["entries"],
  "properties": {
    "region": {
      "description": "Present in region bundles.",
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "en": { "type": "string" },
        "parent": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entries": { "type": "array", "items": { "$ref": "entry.schema.json" } }
  },
  "unevaluatedProperties": false
}
